<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="sb4tables" author="attila.mate">
        <!-- Table: SB4DSSTRING -->
        <createTable tableName="SB4DSSTRING">
            <column name="ID" type="NUMERIC">
                <constraints nullable="false" />
            </column>
            <column name="VAL" type="VARCHAR(1000)" />
        </createTable>

        <createIndex indexName="SB4DSSTRING_ID_IDX" tableName="SB4DSSTRING">
            <column name="ID" />
        </createIndex>

        <createIndex indexName="SB4DSSTRING_VAL_IDX" tableName="SB4DSSTRING">
            <column name="VAL" />
        </createIndex>

        <!-- Table: SB4DSINT -->
        <createTable tableName="SB4DSINT">
            <column name="ID" type="NUMERIC">
                <constraints nullable="false" />
            </column>
            <column name="VAL" type="NUMERIC" />
        </createTable>

        <createIndex indexName="SB4DSINT_ID_IDX" tableName="SB4DSINT">
            <column name="ID" />
        </createIndex>

        <createIndex indexName="SB4DSINT_VAL_IDX" tableName="SB4DSINT">
            <column name="VAL" />
        </createIndex>
    </changeSet>

</databaseChangeLog>
