<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-objectentrylock-table" author="peter.boros">
        <createTable tableName="OBJECT_ENTRY_LOCK">
            <column name="OBJECT_URI" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="APPLICATIONRUTIME" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_AT" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Add primary key to the URI column -->
        <addPrimaryKey columnNames="OBJECT_URI" tableName="OBJECT_ENTRY_LOCK"/>

        <!-- Create unique index for multiple columns -->
        <createIndex indexName="OBJECT_ENTRY_LOCK_IDX_1" tableName="OBJECT_ENTRY_LOCK" unique="true">
            <column name="OBJECT_URI"/>
            <column name="APPLICATIONRUTIME"/>
            <column name="CREATED_AT"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
